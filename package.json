{
  "name": "btv",
  "version": "1.0.0",
  "description": "BTV - lettore IPTV gratuito e open source per Smart TV (Samsung Tizen, LG webOS) e Fire TV Stick / Android TV",
  "private": true,
  "license": "MIT",
  "scripts": {
    "postinstall": "node tools/vendor.js",
    "icons": "powershell -ExecutionPolicy Bypass -File tools/make-icons.ps1",
    "dev": "node tools/serve.js",
    "build:tizen": "node tools/build-tv.js tizen",
    "build:webos": "node tools/build-tv.js webos",
    "android:init": "npx cap add android && node tools/patch-android.js",
    "android:sync": "npx cap sync android && node tools/patch-android.js",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "hls.js": "^1.5.0",
    "pako": "^2.2.0",
    "qrcode-generator": "^2.0.4",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  }
}
